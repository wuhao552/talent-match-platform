# ============================================================================
#  后端环境变量模板  ——  复制为 .env 后填写你自己的值
#      cp .env.example .env
#  .env 已被 .gitignore 忽略，请勿把真实密钥提交到版本库。
# ============================================================================

# ---------------------------- 服务 ----------------------------
# HTTP 监听端口（REST 全局前缀为 /api）
PORT=3100

# ---------------------------- PostgreSQL ----------------------------
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=your_database_password
DB_DATABASE=talent_match

# ---------------------------- JWT ----------------------------
# 必填。登录令牌的签名密钥，未配置时后端启动即报错退出。
# 请替换为足够随机的长字符串，例如：openssl rand -base64 48
JWT_SECRET=please_replace_with_a_long_random_secret

# ------------------- 大模型（主模型） -------------------
# 用于文档解析、技能提取、语义匹配。当前实现以 DeepSeek 为默认提供方。
LLM_PROVIDER=deepseek
LLM_API_KEY=your_deepseek_api_key
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-v4-flash

# ------------------- 大模型（备用模型，可选） -------------------
# 主模型调用失败时会自动切换到备用模型（需同时配置 model 与 api key 才会启用）。
# 代码兼容 FALLBACK_* 与 BACKUP_* 两套命名，配置其中一套即可。
LLM_FALLBACK_API_KEY=your_dashscope_api_key
LLM_FALLBACK_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_FALLBACK_MODEL=qwen3.8-flash

# ------------------- Embedding 向量（阿里云 DashScope） -------------------
# 用于技能语义相似度。未配置 EMBEDDING_API_KEY 时，匹配会自动降级为纯字符串匹配。
EMBEDDING_API_KEY=your_dashscope_api_key
EMBEDDING_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4

# ---------------------------- 可选 ----------------------------
# 技能种子数据目录，默认为 backend/data/entity_map（内含 skill.list 标准技能库）
# ENTITY_MAP_DIR=./data/entity_map

# ============================================================================
#  说明：以下变量曾出现在旧版 .env 中，但当前代码并未读取，故不再列出：
#    JWT_EXPIRES_IN   令牌有效期在 src/common/jwt-config.module.ts 中固定为 7d
#    UPLOAD_DIR       上传目录在 src/modules/document/document.controller.ts 中固定为 ./uploads
#    MAX_FILE_SIZE    单文件大小上限在同一个文件中固定为 10 MB
#  如需改为可配置，请先修改对应代码再补充到本模板。
# ============================================================================
